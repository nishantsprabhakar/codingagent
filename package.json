{
  "name": "wrexlyn",
  "private": true,
  "version": "0.1.0",
  "description": "Wrexlyn — a free, agentic coding assistant with a web UI, document generation, MCP support, and multi-chat sessions.",
  "author": "Nishant Prabhakar",
  "license": "UNLICENSED",
  "bin": {
    "wrexlyn": "dist/index.js",
    "agent": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "web": "tsx src/index.ts --web",
    "eval": "tsx src/eval/cli.ts",
    "typecheck": "tsc -p . --noEmit",
    "test": "npm run build && node scripts/run-tests.js",
    "test:unit": "npm run test",
    "verify": "npm run typecheck && npm run test",
    "audit": "audit-ci --config .audit-ci.json"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "diff": "^5.2.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "glob": "^10.4.5",
    "jszip": "^3.10.1",
    "pdf-parse": "^2.4.5",
    "pptxgenjs": "^4.0.1",
    "puppeteer": "^25.6.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/diff": "^5.2.3",
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.10",
    "audit-ci": "^7.1.0",
    "tsx": "^4.23.12",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
